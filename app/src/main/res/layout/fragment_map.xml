<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Sağ xəritə idarəetmələri -->
    <LinearLayout
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <ImageButton android:id="@+id/layers" android:layout_width="46dp" android:layout_height="46dp"
            android:src="@drawable/ic_layers" android:tint="@color/text" android:padding="12dp" android:background="@drawable/bg_map_fab"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/zoomIn" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginTop="8dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="+" android:textSize="26sp" android:textColor="@color/text" android:backgroundTint="@color/surface" app:cornerRadius="16dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/zoomOut" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginTop="8dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="−" android:textSize="28sp" android:textColor="@color/text" android:backgroundTint="@color/surface" app:cornerRadius="16dp"/>

        <ImageButton android:id="@+id/target" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginTop="8dp"
            android:src="@drawable/ic_target" android:tint="@color/text" android:padding="12dp" android:background="@drawable/bg_map_fab"/>

        <ImageButton android:id="@+id/refresh" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginTop="8dp"
            android:src="@drawable/ic_refresh" android:tint="@color/text" android:padding="12dp" android:background="@drawable/bg_map_fab"/>
    </LinearLayout>

    <!-- User kartı artıq aşağıdadır. Basanda aşağı panel açılır. -->
    <LinearLayout
        android:id="@+id/mapUserCard"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="72dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:elevation="7dp"
        android:clickable="true"
        android:focusable="true">

        <TextView android:id="@+id/mapAvatar" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="U" android:textStyle="bold" android:textColor="@color/purple" android:background="@drawable/bg_round_purple"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="11dp">
            <TextView android:id="@+id/mapChild" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Uşaq" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text"/>
            <TextView android:id="@+id/mapStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Son mövqe" android:textSize="11sp" android:maxLines="1"
                android:ellipsize="end" android:textColor="@color/muted"/>
        </LinearLayout>
        <TextView android:id="@+id/mapBattery" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textStyle="bold" android:textColor="@color/green" android:textSize="14sp"/>
    </LinearLayout>

    <!-- Normalda gizli; User kartına basanda yuxarı açılır -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="338dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_sheet"
        app:behavior_hideable="false"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View android:layout_width="44dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" android:background="@drawable/bg_sheet_handle"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center"
                android:text="●" android:textColor="@color/blue" android:textSize="22sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/mapAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:text="Son mövqe" android:textColor="@color/text"
                    android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/mapMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="Dəqiqlik —" android:textColor="@color/muted" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/route" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1.5" android:text="Marşrut" android:textAllCaps="false" android:textColor="@color/white"
                android:textStyle="bold" app:cornerRadius="15dp" android:backgroundTint="@color/purple"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/history" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Tarixçə" android:textAllCaps="false"
                android:textColor="@color/text" app:cornerRadius="15dp" android:backgroundTint="@color/surface2"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/googleRoute" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:text="Google Maps-da get" android:textAllCaps="false" android:textColor="@color/text"
                app:cornerRadius="15dp" android:backgroundTint="#EAF2FF"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/share" android:layout_width="74dp" android:layout_height="match_parent"
                android:layout_marginStart="8dp" android:text="Paylaş" android:textAllCaps="false" android:textColor="@color/purple"
                app:cornerRadius="15dp" android:backgroundTint="@color/purpleSoft"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Marşrut: default son 1 saat. GPS nöqtəsinə basanda vaxt, dəqiqlik və batareya görünür."
            android:textColor="@color/muted" android:textSize="11sp"/>
        <TextView android:id="@+id/mapSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Son mövqe göstərilir" android:textColor="@color/text"
            android:textStyle="bold" android:textSize="11sp"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
