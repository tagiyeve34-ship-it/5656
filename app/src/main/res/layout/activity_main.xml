    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav"
        android:layout_width="match_parent" android:layout_height="52dp" android:layout_gravity="bottom"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="10dp"
